        <content>
          <p><span style="color:#000000"><b><i>I have read the Impact Assessment and I am satisfied that (a) it represents a fair and reasonable view of the expected costs, benefits and impact of the policy, and (b) the benefits justify the costs.</i></b></span></p>
          <table uk:widths="3.33in 1.87in 0.49in 1.4in">
            <tr>
              <td style="vertical-align:bottom">
                <p><span style="color:#000000">Signed by the responsible Minister:</span></p>
              </td>
              <td style="vertical-align:bottom">
                <p>Mike Penning</p>
              </td>
              <td style="vertical-align:bottom">
                <p><span style="color:#000000"> Date:</span></p>
              </td>
              <td style="vertical-align:bottom">
                <p>27/03/2012 </p>
              </td>
            </tr>
          </table>
        </content>
      </paragraph>
