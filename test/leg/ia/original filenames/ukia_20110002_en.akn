        </paragraph>
        <paragraph>
          <content>
            <p><b>Enforcement, Implementation and Wider Impacts</b></p>
            <table uk:widths="3.64in 0.68in 0.68in 0.68in 0.24in 0.1in 0.34in 0.68in">
              <tr>
