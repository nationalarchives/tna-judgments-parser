#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

## husky task runner examples -------------------
## Note : for local installation use 'dotnet' prefix. e.g. 'dotnet husky'

## run all tasks
#husky run

### run all tasks with group: 'group-name'
#husky run --group group-name

## run task with name: 'task-name'
#husky run --name task-name

## pass hook arguments to task
#husky run --args "$1" "$2"


# Auto-fix linting errors in staged files, then fail if that changed any of them.
# Compare the unstaged changes to staged files before and after, so pre-existing unstaged edits aren't mistaken for fixes.
staged_files=$(git diff --name-only --cached)
unstaged_before=$(git diff -- $staged_files | git hash-object --stdin)

dotnet husky run --name "dotnet-format" --quiet

unstaged_after=$(git diff -- $staged_files | git hash-object --stdin)

if [ "$unstaged_before" != "$unstaged_after" ]; then
    echo "⚠️ Linting errors detected and auto-fixed. Please review and stage the changes before committing."

    exit 1
fi
